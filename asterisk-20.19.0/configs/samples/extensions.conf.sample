[general]
static=yes
writeprotect=no
autofallthrough=yes

[0001]
exten => _X.,1,NoOp(Номер набран: ${EXTEN})
same => n,Set(SIPADDR=${EXTEN:0:3})
same => n,Set(TARGET=${EXTEN:3})
same => n,NoOp(SIP адрес: ${SIPADDR}, целевой номер: ${TARGET})
same => n,Dial(SIP/${EXTEN}@gw${SIPADDR})
same => n,Hangup()

[101]
exten => _X.,1,NoOp(Call from SIP 101)
exten => _X.,n,GotoIf($["${EXTEN:0:1}" = "7" & ${LEN(${EXTEN})}=11]?change:send)
exten => _X.,n(change),Set(CALLED=8${EXTEN:1})
exten => _X.,n,Dial(SIP/101${CALLED}@gw101)
exten => _X.,n,Hangup()
exten => _X.,n(send),Dial(SIP/101${EXTEN}@gw101)
exten => _X.,n,Hangup()

[gw101]
exten => _X.,1,NoOp(Call in from SIP 101)
exten => _X.,n,Dial(SIP/101)
exten => _X.,n,Hangup()

